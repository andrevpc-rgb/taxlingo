# .env.local — variáveis do CLIENTE (ficam no bundle que vai pro navegador).
# Copie para .env.local e preencha. NÃO commitar (já está no .gitignore).
#
# Onde achar: painel do Supabase > Project Settings > API.
# São seguras de expor no navegador (a chave "anon" só funciona através
# das regras de RLS definidas em supabase/schema.sql).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
