# .env — usado só por scripts/seed.mjs (Node, roda no seu terminal, nunca
# no navegador). Copie para .env e preencha. NÃO commitar (já está no
# .gitignore).
#
# Onde achar: painel do Supabase > Project Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key — tem acesso total, ignora RLS. Só usa em scripts server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Conta master (fundador) criada pelo seed.
MASTER_EMAIL=andrevpc@gmail.com
MASTER_PASSWORD=escolha-uma-senha-forte-aqui
